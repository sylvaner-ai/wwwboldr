---
import { getCollection } from 'astro:content';
import CiblePage from '../layouts/CiblePage.astro';
import CaseCard from '../components/CaseCard.astro';
import Articles from '../components/Articles.astro';
import Infra from '../components/viz/Infra.astro';
import RagChat from '../components/viz/RagChat.astro';
import Harness from '../components/viz/Harness.astro';
const services = (await getCollection('services')).filter((s) => s.data.cible === 'adoption').sort((a, b) => a.data.ordre - b.data.ordre);
const cas = (await getCollection('cas')).filter((c) => c.data.cible === 'adoption').sort((a, b) => a.data.ordre - b.data.ordre);
---
<CiblePage photo="eoliennes" titre="Adopter l'IA : infrastructures souveraines, RAG et harnais sécurisés | BoldR" description="Cadrage IA, infrastructures IA souveraines, RAG d'entreprise et harnais de développement sécurisés, conçus par des experts en sécurité." h1="Adoptez l'IA sans perdre la main sur vos données" lead="Vos équipes veulent utiliser l'IA, et vos données ne doivent pas en payer le prix. Nous concevons et construisons avec vous des usages sous contrôle, avec le regard d'experts en cybersécurité.">
  <Fragment slot="visuel"><Infra /></Fragment>

  <section class="section wrap">
    <div class="section-head">
      <h2 class="h2">Quatre services, du cadrage à la construction</h2>
    </div>
    <div class="services services--grid">
      {services.map(({ data }) => (
        <article class="offer">
          <h3 class="h3">{data.titre}</h3>
          <p>{data.promesse}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2 class="h2">Ce que cela donne en pratique</h2>
    </div>
    <div class="viz-pair">
      <figure class="viz-frame">
        <RagChat />
        <figcaption><b>Un RAG qui cite ses sources</b><span>Chaque réponse renvoie à ses documents et respecte les droits de la personne qui pose la question.</span></figcaption>
      </figure>
      <figure class="viz-frame">
        <Harness />
        <figcaption><b>Un harnais qui trace et qui bloque</b><span>Ce que l'IA peut faire, ce qu'elle ne peut pas faire et ce qu'un développeur doit valider sont définis à l'avance.</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2 class="h2">Nos réalisations</h2>
      <p class="lead">Deux missions d'expertise, décrites sans nommer les entreprises concernées.</p>
    </div>
    <div class="cases">{cas.map((c) => <CaseCard cas={c} />)}</div>
  </section>

  <Articles />
</CiblePage>
