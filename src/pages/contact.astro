---
import Base from '../layouts/Base.astro';
const profils = [
  { v: 'investisseur', l: 'Investisseur' },
  { v: 'numerique', l: 'Entreprise du numérique' },
  { v: 'adoption', l: "Entreprise qui adopte l'IA" },
  { v: 'autre', l: 'Autre' },
];
---
<Base titre="Contact | BoldR" description="Présentez-nous votre projet : conseil stratégique et expertise en cybersécurité et IA.">
  <section class="contact wrap section">
    <div class="contact__text">
      <h1 class="display">Parlons de votre projet</h1>
      <p class="lead">Dites-nous où vous en êtes et ce que vous avez à décider. Quelques lignes suffisent pour commencer.</p>
      <p class="muted">Vous préférez écrire directement ? <a href="mailto:contact@boldr.fr">contact@boldr.fr</a></p>
    </div>
    <form class="form" action="/envoi.php" method="post" data-contact>
      <div class="field"><label for="prenom">Prénom</label><input id="prenom" name="prenom" autocomplete="given-name" maxlength="120" required /></div>
      <div class="field"><label for="nom">Nom</label><input id="nom" name="nom" autocomplete="family-name" maxlength="120" required /></div>
      <div class="field"><label for="email">E-mail</label><input id="email" name="email" type="email" autocomplete="email" maxlength="160" required /></div>
      <div class="field"><label for="societe">Société <span class="opt">(facultatif)</span></label><input id="societe" name="societe" autocomplete="organization" maxlength="120" /></div>
      <fieldset class="field field--full">
        <legend>Vous êtes</legend>
        <div class="choices">
          {profils.map((p) => <label class="choice"><input type="radio" name="profil" value={p.v} required /><span>{p.l}</span></label>)}
        </div>
      </fieldset>
      <div class="field field--full"><label for="message">Votre message</label><textarea id="message" name="message" maxlength="5000" required></textarea></div>
      <div class="form__trap" aria-hidden="true"><label for="website">Ne pas remplir</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
      <input type="hidden" name="t" value="" />
      <div class="form__foot">
        <div class="form__error" data-error role="alert" tabindex="-1" hidden><span data-error-text></span> Vous pouvez aussi écrire à <a href="mailto:contact@boldr.fr">contact@boldr.fr</a>.</div>
        <div><button class="btn btn--primary btn--lg" type="submit">Envoyer le message</button></div>
        <p class="form__legal">Vos données servent uniquement à répondre à votre message. <a href="/confidentialite/">En savoir plus</a>.</p>
      </div>
    </form>
  </section>
</Base>
