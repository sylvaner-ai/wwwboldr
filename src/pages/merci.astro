---
import Base from '../layouts/Base.astro';
---
<Base titre="Message envoyé | BoldR" description="Votre message a bien été envoyé." noindex>
  <section class="message wrap">
    <h1 class="display">Votre message est bien parti</h1>
    <p class="lead">Nous l'avons reçu et nous vous répondrons à l'adresse que vous avez indiquée.</p>
    <a class="btn btn--neutral" href="/">Revenir à l'accueil</a>
  </section>
</Base>
