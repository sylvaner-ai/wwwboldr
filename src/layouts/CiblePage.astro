---
import Base from './Base.astro';
import Arrow from '../components/Arrow.astro';
import Cta from '../components/Cta.astro';
interface Props { titre: string; description: string; h1: string; lead: string; photo: string }
const { titre, description, h1, lead, photo } = Astro.props;
---
<Base titre={titre} description={description}>
  <section class="page-hero wrap">
    <div class="page-hero__grid">
      <div class="page-hero__text">
        <h1 class="display">{h1}</h1>
        <p class="lead">{lead}</p>
        <a class="btn btn--primary btn--lg" href="/contact/">Parlons de votre projet <Arrow /></a>
      </div>
      <div class="page-hero__viz"><img class="page-hero__photo" src={`/images/${photo}-1200.webp`} width="1200" height="800" alt="" fetchpriority="high" /><slot name="visuel" /></div>
    </div>
  </section>
  <slot />
  <Cta />
</Base>
