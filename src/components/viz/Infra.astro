---
import Viz from '../Viz.astro';
---
<Viz titre="Infrastructure IA souveraine">
  <span class="pill" slot="head">Schéma type</span>
  <div class="infra">
    <div class="tile node node--wide"><b>Vos équipes et vos applications</b></div>
    <div class="infra__line"></div>
    <div class="infra__perimeter">
      <span class="infra__label">Votre périmètre</span>
      <div class="tile node node--wide"><b>Passerelle</b><span>Droits et journalisation</span></div>
      <div class="infra__line" data-i="2"></div>
      <div class="infra__row">
        <div class="tile node"><b>Modèles</b><span>Hébergés</span></div>
        <div class="tile node"><b>Index</b><span>Vectoriel</span></div>
        <div class="tile node"><b>Données</b><span>Internes</span></div>
      </div>
    </div>
  </div>
</Viz>
